{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Beastagent API",
            "program": "${workspaceFolder}/beastagent-backend/server.js",
            "cwd": "${workspaceFolder}/beastagent-backend",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {
                "PORT": "3000"
            }
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Beastagent Site",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "Beastagent: Run App",
            "configurations": [
                "Debug Beastagent API",
                "Launch Beastagent Site"
            ]
        }
    ]
}